# Public website (Next.js) configuration. Copy to .env.local / .env.production.

# Public URL of THIS website (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://e-grant.aztu.edu.az

# Origin of the Flask backend API (no trailing /api).
NEXT_PUBLIC_API_BASE_URL=https://api-e-grant.aztu.edu.az

# Server-to-server key for /api/public/*. Must equal PUBLIC_API_KEY in the
# backend's .env. SECRET: keep the name WITHOUT the NEXT_PUBLIC_ prefix so it is
# never bundled into browser code. Rebuild/restart after changing it.
PUBLIC_API_KEY=generate-a-long-random-value
